# DFacturas — public settings for the web app.
#
# Local development: run `npm run db:up` and then `npm run env:local`, which writes
# .env.local with the values of your local Supabase. Edit by hand only for a hosted project.
#
# Only public values go here. The Supabase secret key is never needed by the app.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
